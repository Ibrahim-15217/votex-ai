# ---------------------------------------------------------------------------
# Votex AI environment configuration
# Copy this file to .env and change every value marked "change-me".
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database (PostgreSQL is the target; SQLite is convenient for quick local checks)
DATABASE_URL=postgresql+psycopg2://votex:votex@localhost:5432/votex
# DATABASE_URL=sqlite:///./votex.db

# Redis / background work
REDIS_URL=redis://localhost:6379/0

# Evidence storage
EVIDENCE_DIR=./storage/evidence
MAX_EVIDENCE_MB=10

# AI engine
MODEL_PATH=../ai-engine/models/phishing_model.joblib
MODEL_VERSION=hybrid-v0.2.0

# Privacy
K_ANONYMITY=5

# Demo behaviour
AUTO_SEED=true
DEMO_PASSWORD=VotexDemo!23
